# Copy to .env and fill in. `.env` is gitignored — never commit real credentials.
#
# Single connection secret: a native Postgres role + static password on your
# Lakebase database. Lakebase requires TLS, so keep sslmode=require.
LAKEBASE_URL=postgresql://app_user:CHANGE_ME@YOUR_HOST:5432/databricks_postgres?sslmode=require
